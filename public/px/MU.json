8,"shares":1125000000.0,"net_income":8539000000.0},{"fy_end":"2026-09-03","revenue":133188000000.0,"op_margin":0.745863,"eps":74.33,"fcf":58963000000.0,"owner_fcf":80172000000.0,"roic":0.819269,"roe":0.614035,"shares":1143000000.0,"net_income":84969000000.0}],"hist_source":"SEC 10-K","hist_currency":"USD","profile":{"longBusinessSummary":"Micron Technology, Inc. engages in the provision of semiconductor memory and storage products in the United States, Taiwan, Mainland China, other Asia Pacific countries, Japan, Europe, and internationally. It operates through Cloud Memory Business Unit, Core Data Center Business Unit, Mobile and Client Business Unit, and Automotive and Embedded Business Unit segments. The company provides dynamic random access memory (DRAM) products, including High-Bandwidth Memory, doublie data rate, low-power DRAM, and graphics DRAM products; NAND products comprising solid state drives, managed NAND, and multi-chip packages; and NOR products. The company sells its products under the Micron brand name and private labels through its own direct sales force, sales or representative offices, as well as through distributors, retailers, and independent sales representatives. Micron Technology, Inc. was founded in 1978 and is headquartered in Boise, Idaho.","fullTimeEmployees":61000,"city":"Boise","country":"United States","website":"https://www.micron.com","industry":"Semiconductors","sector":"Technology"},"news":[],"info_date":"2026-10-31"}