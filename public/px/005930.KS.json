orea.","fullTimeEmployees":null,"city":"Suwon-si","country":"South Korea","website":"https://www.samsung.com","industry":"Consumer Electronics","sector":"Technology"},"news":[{"title":"Modine Manufacturing (MOD) In Reported Talks Over Data Center Cooling Business","link":"https://finance.yahoo.com/markets/stocks/articles/modine-manufacturing-mod-reported-talks-011851223.html","publisher":"Simply Wall St.","date":"2026-11-14"},{"title":"Samsung Eyeing Deal To Buy Data Center Supplier Modine; Stock Soars 35%","link":"https://www.investors.com/news/samsung-modine-manufacturing-ai-data-center/?src=A00220&yptr=yahoo","publisher":"Investor's Business Daily","date":"2026-11-13"},{"title":"MOD Stock Jumps 30% as Samsung Reportedly Explores Acquisition of Modine","link":"https://www.barchart.com/story/news/8827949/mod-stock-jumps-30-as-samsung-reportedly-explores-acquisition-of-modine","publisher":"Barchart","date":"2026-11-13"},{"title":"Modine Stock Just Soared 29% on a Report That Samsung Wants to Buy It. Is It Too Late to Buy?","link":"https://www.fool.com/investing/2026/11/13/modine-stock-just-soared-29-on-a-report-that-samsung-wants-to-buy-it-is-it-too-late-to-buy/","publisher":"Motley Fool","date":"2026-11-13"},{"title":"SK hynix Stocks Fall 3.03% as Nvidia Leadership Shock Hits Key HBM Supplier","link":"https://finance.yahoo.com/markets/stocks/articles/sk-hynix-stocks-fall-3-183209379.html","publisher":"GuruFocus.com","date":"2026-11-13"},{"title":"Samsung Electronics Stocks Move Lower as Nvidia CEO Exit Tests AI Memory Rally","link":"https://finance.yahoo.com/markets/stocks/articles/samsung-electronics-stocks-move-lower-183110049.html","publisher":"GuruFocus.com","date":"2026-11-13"}],"info_date":"2026-11-14"}