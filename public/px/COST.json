88,"roe":0.277705,"shares":444803000.0,"net_income":8099000000.0},{"fy_end":"2026-08-30","revenue":303154000000.0,"op_margin":0.0385448,"eps":20.76,"fcf":9382000000.0,"owner_fcf":13143000000.0,"roic":0.404438,"roe":0.257688,"shares":444427000.0,"net_income":9226000000.0}],"hist_source":"SEC 10-K","hist_currency":"USD","profile":{"longBusinessSummary":"Costco Wholesale Corporation, together with its subsidiaries, engages in the operation of membership warehouses in the United States, Puerto Rico, Canada, Mexico, Japan, the United Kingdom, Korea, Australia, Taiwan, China, Spain, France, Sweden, Iceland, and New Zealand. It offers merchandise, including sundries, dry groceries, candies, coolers, freezers, liquor, and tobacco; non-food merchandise comprising consumer electronics, appliances, small electrics, health and beauty aids, hardware, lawn and garden, sporting goods, tires, toys and seasonal, automotive, stamps, tickets, apparel, furniture, domestics, housewares, special order kiosks, and jewelry; and fresh food, such as meat, produce, deli, and bakery products. The company is also involved in warehouse ancillary operations, which include gasoline, pharmacies, food courts, optical, hearing aids, and tire installation centers. In addition, it engages in e-commerce, business centers, travel, and other businesses. Further, the company operates e-commerce sites; and offers branded and private-label products in various categories. The company was formerly known as Costco Companies, Inc. and changed its name to Costco Wholesale Corporation in August 1999. Costco Wholesale Corporation was founded in 1976 and is based in Issaquah, Washington.","fullTimeEmployees":355000,"city":"Issaquah","country":"United States","website":"https://www.costco.com","industry":"Discount Stores","sector":"Consumer Defensive"},"news":[{"title":"Black Friday Push Could Be A Big Moment For Costco Stock (COST)","link":"https://finance.yahoo.com/markets/stocks/articles/black-friday-push-could-bi