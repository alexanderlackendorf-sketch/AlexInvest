0000.0,"roic":0.665587,"roe":null,"shares":200284000.0,"net_income":1509120000.0},{"fy_end":"2025-09-30","revenue":321333000000.0,"op_margin":0.0081803,"eps":7.96,"fcf":3179240000.0,"owner_fcf":3179240000.0,"roic":0.370122,"roe":1.0306,"shares":195214000.0,"net_income":1554170000.0}],"hist_source":"SEC 10-K","hist_currency":"USD","profile":{"longBusinessSummary":"Cencora, Inc. sources and distributes pharmaceutical products in the United States and internationally. The company's U.S. Healthcare Solutions segment distributes generic and injectable pharmaceuticals, over-the-counter healthcare products, home healthcare supplies and equipment, and related services to acute care hospitals and health systems, independent and chain retail pharmacies, mail order pharmacies, medical clinics, long-term care and alternate site pharmacies, and other customers; distributes plasma and other blood products, vaccines, and other specialty pharmaceutical products; provides pharmacy management, staffing, and other consulting services; supply management software to retail and institutional healthcare providers; packaging solutions to institutional and retail healthcare providers; clinical trial support, product post-approval, and commercialization support services; data analytics, outcomes research, and other services for biotechnology and pharmaceutical manufacturers; pharmaceuticals, vaccines, parasiticides, diagnostics, micro feed ingredients, and other products to the companion animal and production animal markets; sales force services to manufacturers; and offers other services to physicians who specialize in various disease states, such as oncology, as well as to other healthcare providers, including hospitals and dialysis clinics. Its International Healthcare Solutions segment provides international pharmaceutical wholesale and related service, and global commercialization services; distributes pharmaceuticals, other healthcare products, and related services to pharmacies, doctors, health centers, and hospitals; and offers specialty transportation and logistics services for the biopharmaceutical industry. The company was formerly known as AmerisourceBergen Corporation and changed its name to Cencora, Inc. in August 2023. Cencora, Inc. was founded in 1871 and is headquartered in Conshohocken, Pennsylvania.","fullTimeEmployees":null,"city":"Conshohocken","country":"United States","website":"https://www.cencora.com","industry":"Medical Distribution","sector":"Healthcare"},"news":[{"title":"Amgen vs. Vertex Pharmaceuticals: Which Healthcare Stock Is a Better Buy for 2027?","link":"https://www.fool.com/coverage/better-buy/2026/11/13/amgen-vs-vertex-pharmaceuticals-which-healthcare-stock-is-a-better-buy-for-2027/","publisher":"Motley Fool","date":"2026-11-13"},{"title":"Update: FTC Sues to Block Covetrus' $3.5 Billion Acquisition of Cencora's MWI Veterinary Supply","link":"https://finance.yahoo.com/healthcare/articles/ftc-sues-block-covetrus-apos-221439804.html","publisher":"MT Newswires","date":"2026-11-13"},{"title":"US FTC sues to block Cencora's $3.5 billion sale of veterinary unit to Covetrus","link":"https://finance.yahoo.com/news/us-ftc-sues-block-cencoras-165038950.html","publisher":"Reuters","date":"2026-11-13"},{"title":"Can Cardinal Health Stock Repeat Its Last Five Years?","link":"https://www.trefis.com/stock/cah/articles/624067/can-cardinal-health-stock-repeat-its-last-five-years/2026-11-10","publisher":"Trefis","date":"2026-11-10"},{"title":"Cencora’s Q3 CY2026 earnings call: our top 5 analyst questions","link":"https://finance.yahoo.com/markets/stocks/articles/cencora-q3-cy2026-earnings-call-212536876.html","publisher":"StockStory","date":"2026-11-08"},{"title":"Is McKesson Stock Increasing Your Market Risk?","link":"https://www.trefis.com/stock/mck/articles/623268/is-mckesson-stock-increasing-your-market-risk/2026-11-06","publisher":"Trefis","date":"2026-11-06"}],"info_date":"2026-11-14"}