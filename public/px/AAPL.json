00.0,"owner_fcf":99784000000.0,"roic":0.797297,"roe":null,"shares":15004700000.0,"net_income":112010000000.0},{"fy_end":"2026-09-26","revenue":478834000000.0,"op_margin":0.3301,"eps":8.98,"fcf":136056000000.0,"owner_fcf":136056000000.0,"roic":0.800941,"roe":1.17915,"shares":14720300000.0,"net_income":132175000000.0}],"hist_source":"SEC 10-K","hist_currency":"USD","profile":{"longBusinessSummary":"Apple Inc. designs, manufactures, and markets smartphones, personal computers, tablets, wearables, and accessories. The company offers iPhone, a line of smartphones; Mac, a line of personal computers; iPad, a line of multi-purpose tablets; and wearables, home, and accessories, including Apple Watch, AirPods, Beats products, Apple Vision Pro, Apple TV 4K, HomePod, and Apple HomeView, as well as Apple branded and third-party accessories. It also provides advertising services comprising third-party licensing arrangements and own advertising platforms; AppleCare and cloud services; and payment services, including Apple Card and Apple Pay. In addition, the company operates App Store that allow customers to discover and download applications and digital content, such as books, music, video, games, and podcasts. Further, it provides digital content through subscription-based services, including Apple Arcade, a game service; Apple Fitness+, a personalized fitness service; Apple Music, which offers users a curated listening experience; Apple News+, a news and magazine service; and Apple TV, which offers original content and live sports. The company sells its products and resells third-party products through its retail and online stores, and direct sales force; its services through its various service platforms; and third-party cellular network carriers and other resellers. It serves consumer, small and mid-sized business, education, enterprise, and government markets. The company operates in North and South America, European countries, India, the Middle East, Africa, China mainland, Hong Kong, Taiwan, Japan, Australia, New Zealand, and rest of Asia. The company was formerly known as Apple Computer, Inc. and changed its name to Apple Inc. in January 2007. Apple Inc. was founded in 1976 and is headquartered in Cupertino, California.","fullTimeEmployees":167000,"city":"Cupertino","country":"United States","website":"https://www.apple.com","industry":"Consumer Electronics","sector":"Technology"},"news":[{"title":"What to make of Jensen Huang's resignation: AI Investing Panel","link":"https://finance.yahoo.com/video/what-to-make-of-jensen-huangs-resignation-ai-investing-panel-144935369.html","publisher":"Yahoo Finance Video","date":"2026-11-13"},{"title":"Is Apple Stock a Buy Right Now?","link":"https://www.fool.com/investing/2026/11/13/is-apple-stock-a-buy-right-now/","publisher":"Motley Fool","date":"2026-11-14"},{"title":"Nvidia's competitors pounce, and what GPU rental prices say about the AI race","link":"https://finance.yahoo.com/video/nvidias-competitors-pounce-and-what-gpu-rental-prices-say-about-the-ai-race-221551379.html","publisher":"Yahoo Finance Video","date":"2026-11-13"},{"title":"Stock Market Today: Indexes Trim Losses, Manage To Score Weekly Gains Despite Strong Volatility","link":"https://www.investors.com/market-trend/stock-market-today/dow-jones-sp500-nasdaq-ppi-inflation-data-cerebras-earnings/?src=A00220&yptr=yahoo","publisher":"Investor's Business Daily","date":"2026-11-13"},{"title":"A $1,999 Sellout. What China Renaissance Sees in Apple (AAPL)","link":"https://finance.yahoo.com/markets/stocks/articles/1-999-sellout-china-renaissance-211310813.html","publisher":"Insider Monkey","date":"2026-11-13"},{"title":"Inside Jim Cramer’s Charitable Trust: 5 Stocks He Actually Owns","link":"https://finance.yahoo.com/markets/stocks/articles/inside-jim-cramer-charitable-trust-203302856.html","publisher":"Insider Monkey","date":"2026-11-13"}],"info_date":"2026-11-14"}